# Private AI settings for a Demo System deployment
#
# 1. Copy this file to .env on your own computer.
# 2. Enter a newly created API key after AI_API_KEY=.
# 3. Run: powershell -ExecutionPolicy Bypass -File scripts\pack-deployment.ps1
# 4. Upload the resulting procureos-deployment.zip once, then Deploy.
#
# The packer includes the full source tree and this local .env at ZIP root.
# Never commit .env, upload a ZIP containing only .env, or share the resulting ZIP.

AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
QUOTATION_AI_MODEL=gpt-4o

# Enables server-side AI supplier ranking when a valid OpenAI configuration exists.
AI_SUPPLIER_SUGGESTIONS=1

# Required only when the deployed system intentionally runs with DEMO_MODE=1.
DEMO_ALLOW_EXTERNAL_AI=1

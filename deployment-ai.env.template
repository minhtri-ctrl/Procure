# Upload workflow for Demo System
# 1. Copy this file and rename the copy to .env (keep the leading dot).
# 2. Enter the newly created OpenAI API key after AI_API_KEY=.
# 3. ZIP the .env file only, then upload that ZIP AFTER importing GitHub and BEFORE Deploy.
# This template contains no secret and is safe to commit. The resulting .env must not be committed.

AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
QUOTATION_AI_MODEL=gpt-4o

# Must be 1 for server-side AI supplier ranking.
AI_SUPPLIER_SUGGESTIONS=1

# Set only when the deployed system intentionally runs in DEMO_MODE=1.
DEMO_ALLOW_EXTERNAL_AI=1

# Server
PORT=8080

# MySQL connection: use DATABASE_URL or the individual fields below.
DATABASE_URL=mysql://user:password@host:3306/procureos
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=procureos

# Authentication
JWT_SECRET=replace-with-a-long-local-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@garena.vn
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrator
ALLOWED_DOMAIN=garena.vn

# Quotation AI (server-side only; never commit a real key)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
QUOTATION_AI_MODEL=gpt-4o
# Enable server-side AI ranking of internal supplier history (explicit opt-in).
AI_SUPPLIER_SUGGESTIONS=0
# Leave empty until an approved external supplier-search adapter is configured.
SUPPLIER_EXTERNAL_SEARCH_PROVIDER=
# DEMO_MODE sends files to OpenAI only after explicit opt-in.
DEMO_ALLOW_EXTERNAL_AI=0

# Optional Google Sheets backup
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS_FILE=secrets/your-service-account-key.json
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON=<base64 JSON service-account key>
BACKUP_INTERVAL_MINUTES=10
